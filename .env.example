# ---------- App
APP_NAME=pm25-tracker
APP_ENV=dev

# ---------- Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=user
PG_PASSWORD=user1234
PG_DATABASE=data-base-name
PG_SCHEMA=public
PG_SSL_MODE=disable

# ---------- Air4Thai Api
AIR4THAI_URL=http://example.com/api

# ---------- My location
LOCAL_STATION_RADIUS_KM=50

# ---------- ETL
ETL_SCHEDULE=15 * * * *
ETL_RUN_ON_START=true
HTTP_TIMEOUT_SECONDS=30

# ---------- Client
CLIENT_PORT=3000
VITE_API_URL=http://localhost:3001

# ---------- Server
SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000